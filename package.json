{
  "name": "pokedeluge",
  "private": true,
  "version": "0.3.2",
  "type": "module",
  "description": "RPG de Pokemon jogavel no navegador, PWA mobile-first",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "assets": "tsx tools/build-all.ts",
    "assets:world": "tsx tools/build-world.ts",
    "assets:dex": "tsx tools/build-dex.ts",
    "assets:sprites": "tsx tools/prefetch-sprites.ts",
    "test": "vitest run",
    "test:update": "tsx tools/test-update.ts",
    "test:capture": "tsx tools/test-capture.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@pkmn/dex": "^0.10.11",
    "@types/node": "^22.15.3",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.7.3",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.1",
    "vitest": "^3.2.4"
  }
}
