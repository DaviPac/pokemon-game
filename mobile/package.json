{
  "name": "pokedeluge-mobile",
  "private": true,
  "version": "0.7.0",
  "description": "PokeDeluge para Android, em NativeScript",
  "main": "src/app.ts",
  "scripts": {
    "web": "npm --prefix .. run build:native",
    "build": "ns build android --release --key-store-path keys/pokedeluge-sideload.keystore --key-store-password pokedeluge --key-store-alias pokedeluge --key-store-alias-password pokedeluge --copy-to dist/PokeDeluge.apk",
    "build:debug": "ns build android --copy-to dist/PokeDeluge-debug.apk"
  },
  "dependencies": {
    "@nativescript/core": "~9.1.0"
  },
  "devDependencies": {
    "@nativescript/android": "9.1.1",
    "@nativescript/types": "~9.0.0",
    "@nativescript/webpack": "~5.0.25",
    "typescript": "~5.8.0"
  }
}
