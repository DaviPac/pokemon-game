<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      No Android 15 o app desenharia por baixo das barras do sistema. O jogo ja
      cuida das bordas seguras no navegador, mas a WebView nao recebe essas
      medidas: fica mais simples manter as barras de fora, na cor do fundo.
    -->
    <style name="AppThemeBase35" parent="AppThemeBase29">
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>

    <style name="AppTheme" parent="AppThemeBase35">
    </style>

    <style name="LaunchScreenTheme" parent="LaunchScreenThemeBase">
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
